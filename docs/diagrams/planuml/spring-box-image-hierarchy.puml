<style>
  .STYLE_EXTERNAL {
    RoundCorner 20
    LineThickness 2
    LineColor #FF6F00
    BackgroundColor #FFD740
  }

  .STYLE_BASE {
    RoundCorner 20
    LineThickness 2
    LineColor #33691E
    BackgroundColor #CCFF90
  }

  .STYLE_CORE {
    RoundCorner 20
    LineThickness 2
    LineColor #33691E
    BackgroundColor #76FF03
  }

  .STYLE_INFRA {
    RoundCorner 20
    LineThickness 2
    LineColor #006064
    BackgroundColor #84FFFF
  }

  .STYLE_APP {
    RoundCorner 20
    LineThickness 2
    LineColor #006064
    BackgroundColor #00E5FF
  }

  .STYLE_MONITOR {
    RoundCorner 20
    LineThickness 2
    LineColor #880E4F
    BackgroundColor #FF80AB
  }

  caption {
    FontSize 22
    FontColor black
    Margin 50
  }
</style>

skinparam backgroundcolor transparent
skinparam ParticipantBackgroundColor transparent
skinparam DatabaseBackgroundColor transparent
skinparam ActorBackgroundColor transparent
skinparam NoteBackgroundColor transparent
skinparam ArrowThickness 2
skinparam ArrowColor #607D8B
skinparam defaultTextAlignment center

caption Remal Spring-Box Docker Image Hierarchy

sprite $EXTERNAL_IMAGE jar:archimate/meaning
sprite $BASE_IMAGE     jar:archimate/goal
sprite $CORE_IMAGE     jar:archimate/interaction
sprite $INFRA_IMAGE    jar:archimate/network
sprite $APP_IMAGE      jar:archimate/physical-equipment
sprite $MONITOR_IMAGE  jar:archimate/assignment

rectangle "alpine"                                                                  as alpine          <<$EXTERNAL_IMAGE>> <<STYLE_EXTERNAL>>
rectangle "zookeeper"                                                               as zookeeper       <<$EXTERNAL_IMAGE>> <<STYLE_EXTERNAL>>
rectangle "kafka"                                                                   as kafka           <<$EXTERNAL_IMAGE>> <<STYLE_EXTERNAL>>
rectangle "<b>Base\nspringbox-base"                                                 as base            <<$BASE_IMAGE>>     <<STYLE_BASE>>
rectangle "<b>OpenJDK-11\nspringbox-openjdk-11"                                     as java11          <<$CORE_IMAGE>>     <<STYLE_CORE>>
rectangle "<b>OpenJDK-17\nspringbox-openjdk-17"                                     as java17          <<$CORE_IMAGE>>     <<STYLE_CORE>>
rectangle "<b>OpenJDK-21\nspringbox-openjdk-21"                                     as java21          <<$CORE_IMAGE>>     <<STYLE_CORE>>
rectangle "<b>OpenJDK-25\nspringbox-openjdk-25"                                     as java25          <<$CORE_IMAGE>>     <<STYLE_CORE>>
rectangle "Private PKI"                                                             as pki             <<$INFRA_IMAGE>>    <<STYLE_INFRA>>
rectangle "Apache Tomcat 9"                                                         as tomcat9         <<$INFRA_IMAGE>>    <<STYLE_INFRA>>
rectangle "ForgeRock Directory Services"                                            as ds              <<$INFRA_IMAGE>>    <<STYLE_INFRA>>
rectangle "ForgeRock Access Management"                                             as am              <<$INFRA_IMAGE>>    <<STYLE_INFRA>>
rectangle "<b>HashiCorp Vault\nspringbox-vault"                                     as vault           <<$INFRA_IMAGE>>    <<STYLE_INFRA>>

##rectangle "<b>HashiCorp Consul for OpenJDK 21\nspringbox-consul-for-openjdk-21"     as consul_21       <<$INFRA_IMAGE>>    <<STYLE_INFRA>>
##rectangle "<b>HashiCorp Consul for OpenJDK 25\nspringbox-consul-for-openjdk-25"     as consul_25       <<$INFRA_IMAGE>>    <<STYLE_INFRA>>
rectangle "<b>HashiCorp Consul"     as consul       <<$INFRA_IMAGE>>    <<STYLE_INFRA>>

rectangle "<b>OpenJDK-21 Runner\nspringbox-openjdk-21-runner"                       as java_runner_21  <<$APP_IMAGE>>      <<STYLE_APP>>
rectangle "<b>OpenJDK-21 Runner + PostgreSQL\nspringbox-openjdk-21-postgres-runner" as java_runner_21p <<$APP_IMAGE>>      <<STYLE_APP>>
rectangle "<b>OpenJDK-21 Omni Runner\nspringbox-openjdk-21-omni-runner"             as java_runner_21o <<$APP_IMAGE>>      <<STYLE_APP>>
rectangle "<b>OpenJDK-25 Runner\nspringbox-openjdk-25-runner"                       as java_runner_25  <<$APP_IMAGE>>      <<STYLE_APP>>
rectangle "<b>OpenJDK-25 Runner + PostgreSQL\nspringbox-openjdk-25-postgres-runner" as java_runner_25p <<$APP_IMAGE>>      <<STYLE_APP>>
rectangle "Hazelcast Platform"                                                      as hazelcast       <<$INFRA_IMAGE>>    <<STYLE_INFRA>>
rectangle "Prometheus"                                                              as prometheus      <<$MONITOR_IMAGE>>  <<STYLE_MONITOR>>
rectangle "Grafana"                                                                 as grafana         <<$MONITOR_IMAGE>>  <<STYLE_MONITOR>>

alpine --> base
base --> java11
base --> java17
base --> java21
base --> java25
java17 --> pki
base ---> vault
base -------> prometheus
base -------> grafana
java11 --> tomcat9
java17 --> ds
##java21 --> consul_21
java21 --> hazelcast
tomcat9 --> am
##consul_21 --> java_runner_21
java_runner_21 --> java_runner_21p
java_runner_21p --> java_runner_21o
##java25 --> consul_25
java25 --> consul
##consul_25 --> java_runner_25
java_runner_25 --> java_runner_25p
@enduml